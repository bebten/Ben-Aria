          class MainActivity : ComponentActivity() {
              override fun onCreate(savedInstanceState: Bundle?) {
                  super.onCreate(savedInstanceState)
                  setContent {
                      AriaTheme {
                          Surface(
                              modifier = Modifier.fillMaxSize(),
                              color = MaterialTheme.colorScheme.background
                          ) {
                              ChatScreen()
                          }
                      }
                  }
              }
          }

          @OptIn(ExperimentalMaterial3Api::class)
          @Composable
          fun ChatScreen(vm: ChatViewModel = viewModel()) {

              var input by remember { mutableStateOf("") }
              var showSettings by remember { mutableStateOf(false) }
              val listState = rememberLazyListState()

              LaunchedEffect(vm.messages.size, vm.messages.lastOrNull()?.content) {
                  if (vm.messages.isNotEmpty()) listState.scrollToItem(vm.messages.lastIndex)
              }

              Scaffold(
                  topBar = {
                      TopAppBar(
                          title = {
                              Column {
                                  Text("Ben Aria", fontWeight = FontWeight.SemiBold)
                                  Text(
                                      vm.model,
                                      style = MaterialTheme.typography.labelSmall,
                                      color = MaterialTheme.colorScheme.onSurfaceVariant,
                                      maxLines = 1
                                  )
                              }
                          },
                          actions = {
                              IconButton(onClick = { vm.clear() }) {
                                  Icon(Icons.Filled.Delete, contentDescription = "Temizle")
                              }
                              IconButton(onClick = { showSettings = true }) {
                                  Icon(Icons.Filled.Settings, contentDescription = "Ayarlar")
                              }
                          }
                      )
                  },
                  bottomBar = {
                      Column {
                          vm.error?.let { err ->
                              Text(
                                  err,
                                  modifier = Modifier
                                      .fillMaxWidth()
                                      .padding(horizontal = 16.dp, vertical = 4.dp),
                                  color = MaterialTheme.colorScheme.error,
                                  style = MaterialTheme.typography.bodySmall
                              )
                          }
                          Row(
                              modifier = Modifier
                                  .fillMaxWidth()
                                  .padding(10.dp),
                              verticalAlignment = Alignment.Bottom
                          ) {
                              OutlinedTextField(
                                  value = input,
                                  onValueChange = { input = it },
                                  modifier = Modifier.weight(1f),
                                  placeholder = { Text("Aria'ya bir sey sor...") },
                                  maxLines = 5,
                                  shape = RoundedCornerShape(20.dp),
                                  keyboardOptions = KeyboardOptions(imeAction = ImeAction.Send),
                                  keyboardActions = KeyboardActions(onSend = {
                                      if (input.isNotBlank()) {
                                          vm.send(input)
                                          input = ""
                                      }
                                  })
                              )
                              Spacer(Modifier.width(8.dp))
                              FilledIconButton(onClick = {
                                  if (vm.streaming) {
                                      vm.stop()
                                  } else if (input.isNotBlank()) {
                                      vm.send(input)
                                      input = ""
                                  }
                              }) {
                                  Icon(
                                      if (vm.streaming) Icons.Filled.Close else Icons.Filled.Send,
                                      contentDescription = null
                                  )
                              }
                          }
                      }
                  }
              ) { innerPadding ->
                  SelectionContainer {
                      LazyColumn(
                          state = listState,
                          modifier = Modifier
                              .fillMaxSize()
                              .padding(innerPadding),
                          verticalArrangement = Arrangement.spacedBy(6.dp)
                      ) {
                          items(vm.messages) { m -> Bubble(m) }
                      }
                  }
              }

              if (showSettings) {
                  SettingsDialog(vm = vm, onClose = { showSettings = false })
              }
          }

          @Composable
          fun Bubble(m: Msg) {
              val isUser = m.role == "user"
              Row(
                  modifier = Modifier
                      .fillMaxWidth()
                      .padding(horizontal = 12.dp),
                  horizontalArrangement = if (isUser) Arrangement.End else Arrangement.Start
              ) {
                  Surface(
                      color = if (isUser) MaterialTheme.colorScheme.primary
                      else MaterialTheme.colorScheme.surfaceVariant,
                      shape = RoundedCornerShape(18.dp),
                      modifier = Modifier.widthIn(max = 320.dp)
                  ) {
                      Text(
                          text = m.content.ifEmpty { "..." },
                          modifier = Modifier.padding(horizontal = 14.dp, vertical = 10.dp),
                          color = if (isUser) MaterialTheme.colorScheme.onPrimary
                          else MaterialTheme.colorScheme.onSurfaceVariant,
                          style = MaterialTheme.typography.bodyMedium
                      )
                  }
              }
          }

          @OptIn(ExperimentalMaterial3Api::class)
          @Composable
          fun SettingsDialog(vm: ChatViewModel, onClose: () -> Unit) {

              var key by remember { mutableStateOf(vm.apiKey) }
              var url by remember { mutableStateOf(vm.baseUrl) }
              var mdl by remember { mutableStateOf(vm.model) }
              var prompt by remember { mutableStateOf(vm.systemPrompt) }
              var temp by remember { mutableStateOf(vm.temperature) }

              AlertDialog(
                  onDismissRequest = onClose,
                  title = { Text("Ayarlar") },
                  text = {
                      Column(
                          modifier = Modifier.verticalScroll(rememberScrollState()),
                          verticalArrangement = Arrangement.spacedBy(10.dp)
                      ) {
                          Text(
                              "Hazir secenekler:",
                              style = MaterialTheme.typography.labelMedium
                          )
                          Presets.LIST.forEach { p ->
                              AssistChip(
                                  onClick = {
                                      url = p.url
                                      mdl = p.model
                                  },
                                  label = { Text(p.label) }
                              )
                          }

                          OutlinedTextField(
                              value = key, onValueChange = { key = it },
                              label = { Text("API anahtari (Pollinations icin bos kalabilir)") },
                              modifier = Modifier.fillMaxWidth(), singleLine = true
                          )
                          OutlinedTextField(
                              value = url, onValueChange = { url = it },
                              label = { Text("Sunucu adresi") },
                              modifier = Modifier.fillMaxWidth(), singleLine = true
                          )
                          OutlinedTextField(
                              value = mdl, onValueChange = { mdl = it },
                              label = { Text("Model") },
                              modifier = Modifier.fillMaxWidth(), singleLine = true
                          )

                          Text(
                              "Sicaklik: " + String.format("%.2f", temp),
                              style = MaterialTheme.typography.labelMedium
                          )
                          Slider(
                              value = temp,
                              onValueChange = { temp = it },
                              valueRange = 0f..1.5f
                          )

                          OutlinedTextField(
                              value = prompt, onValueChange = { prompt = it },
                              label = { Text("Sistem talimati (Aria'nin kisiligi)") },
                              modifier = Modifier
                                  .fillMaxWidth()
                                  .heightIn(min = 180.dp)
                          )
                      }
                  },
                  confirmButton = {
                      TextButton(onClick = {
                          vm.saveSettings(key, url, mdl, prompt, temp)
                          onClose()
                      }) { Text("Kaydet") }
                  },
                  dismissButton = {
                      TextButton(onClick = onClose) { Text("Iptal") }
                  }
              )
          }
          EOF

          echo "Dosyalar hazir."

      - name: APK derle
        run: gradle assembleDebug --no-daemon

      - name: APK adini duzenle
        run: cp app/build/outputs/apk/debug/app-debug.apk BenAria.apk

      - name: Indirilebilir surum olustur
        uses: softprops/action-gh-release@v2
        with:
          tag_name: v1.${{ github.run_number }}
          name: Ben Aria v1.${{ github.run_number }}
          body: "Ben Aria APK. Telefonuna kurmak icin asagidaki BenAria.apk dosyasini indir."
          files: BenAria.apk

      - name: Yedek olarak da yukle
        uses: actions/upload-artifact@v4
        with:
          name: BenAria-APK
          path: BenAria.apk
